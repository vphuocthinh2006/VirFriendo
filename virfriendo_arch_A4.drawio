        <mxCell id="mon-group" value="Monitoring &amp;  Alerting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontStyle=1;fontColor=#5A2EBE;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="830" y="395" width="325" height="240" as="geometry" />
