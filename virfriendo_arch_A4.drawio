        <mxCell id="cw-icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="mon-group">
          <mxGeometry x="10" y="26" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cw-label" value="CloudWatch Logs — /ecs/virfriendo-api&#10;30-day retention" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;" vertex="1" parent="mon-group">
          <mxGeometry x="56" y="26" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cw-alarms" value="CloudWatch Alarms (7) :&#10;1. ECS CPU &gt; 70%  → scale-out&#10;2. ECS CPU &lt; 63%  → scale-in&#10;3. ALB 5xx error rate&#10;4. Target group unhealthy hosts&#10;5. Aurora ACU &gt; threshold&#10;6. NAT Gateway error rate&#10;7. SNS publish failures" style="text;html=1;align=left;verticalAlign=top;fontSize=7.5;fillColor=#FFFFFF;strokeColor=#8C4FFF;rounded=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="mon-group">
          <mxGeometry x="10" y="74" width="305" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sns-icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_notification_service;" vertex="1" parent="mon-group">
          <mxGeometry x="10" y="184" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sns-label" value="SNS Topic: pally-alerts  →  email&#10;vphuocthinh1@gmail.com" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;" vertex="1" parent="mon-group">
          <mxGeometry x="56" y="184" width="260" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== Bottom legend / data flow ==================== -->
        <mxCell id="legend" value="Data flow:  Users → Cloudflare (DNS+Pages serves SPA) → CF Proxy api.virfriendo.win → AWS WAF → IGW → ALB (multi-AZ)  →  ECS Fargate tasks (private subnet)  ↔  Aurora (SQL/TLS, asyncpg)  ·  S3 (presigned PUT/GET via Gateway Endpoint)  ·  Secrets Manager (GetSecretValue)  ·  ECR (docker pull)  ·  CloudWatch (logs push)  ·  SNS → email on alarm" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;fillColor=#FAFBFC;strokeColor=#CCCCCC;rounded=1;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="15" y="650" width="1140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="Resilience:  Multi-AZ (ap-southeast-1a / 1b)  ·  Aurora streaming replication + auto-failover  ·  ALB cross-AZ routing  ·  ECS auto-scaling 1–3 tasks per AZ&#10;Security:  WAF (CommonRuleSet + SQLi, 2000 req/IP/5min)  ·  Cloudflare proxy/TLS  ·  Private subnets for ECS &amp; DB  ·  VPC Endpoints (no public internet for AWS APIs)  ·  S3 public access blocked (presigned URLs only)  ·  Secrets in Secrets Manager (no env vars)  ·  Least-privilege IAM (task vs. execution role)" style="text;html=1;align=left;verticalAlign=middle;fontSize=7.5;fillColor=#FFFEF7;strokeColor=#E0C97A;rounded=1;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="15" y="710" width="1140" height="58" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Build: virfriendo-api:v11  ·  Task Def: virfriendo-api:33  ·  Postgres 16.6  ·  Aurora Serverless v2 (0.5–4 ACU)  ·  ECS Fargate 2 vCPU / 6 GB" style="text;html=1;align=center;verticalAlign=middle;fontSize=7.5;fontColor=#5A6772;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="15" y="775" width="1140" height="20" as="geometry" />
        </mxCell>

