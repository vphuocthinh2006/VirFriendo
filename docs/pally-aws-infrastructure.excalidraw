    },
    {
      "id": "notes_body",
      "type": "text",
      "x": 80,
      "y": 1390,
      "width": 2480,
      "height": 180,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "text": "▸ Frontend (virfriendo.win) is on Cloudflare Pages — never hits AWS. Only api.virfriendo.win goes through Cloudflare proxy → WAF → ALB → ECS.\n▸ Aurora endpoint sits inside VPC private subnets — only reachable from ECS tasks (and bastion if any).\n▸ S3 bucket has Public Access Block — clients access via 7-day presigned URLs from the api.\n▸ Secrets Manager 'virfriendo/prod/database' holds DB URL + ALL API keys (Anthropic, Groq, OpenAI, Gemini, Deepgram, Replicate, Tavily, Google OAuth, JWT secret).\n▸ ECR lifecycle keeps only the 2 most-recent revisions (current: 10, 11). Old RDS db.t4g.micro is stopped, pending delete.\n\nTYPE OF SYSTEM DESIGN:  Cloud-native 3-tier web application on AWS  ·  Stateless containerised compute (ECS Fargate Auto-Scaling)  ·  Serverless DB (Aurora v2)\n                         Edge proxy (Cloudflare) in front of regional ALB  ·  WAF-protected ingress  ·  Centralised secrets + per-task IAM (least-privilege)\n                         Observability via CloudWatch Logs+Alarms+SNS  ·  GitOps CI/CD (GitHub Actions → ECR → ECS rolling deploy)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "▸ Frontend (virfriendo.win) is on Cloudflare Pages — never hits AWS. Only api.virfriendo.win goes through Cloudflare proxy → WAF → ALB → ECS.\n▸ Aurora endpoint sits inside VPC private subnets — only reachable from ECS tasks (and bastion if any).\n▸ S3 bucket has Public Access Block — clients access via 7-day presigned URLs from the api.\n▸ Secrets Manager 'virfriendo/prod/database' holds DB URL + ALL API keys (Anthropic, Groq, OpenAI, Gemini, Deepgram, Replicate, Tavily, Google OAuth, JWT secret).\n▸ ECR lifecycle keeps only the 2 most-recent revisions (current: 10, 11). Old RDS db.t4g.micro is stopped, pending delete.\n\nTYPE OF SYSTEM DESIGN:  Cloud-native 3-tier web application on AWS  ·  Stateless containerised compute (ECS Fargate Auto-Scaling)  ·  Serverless DB (Aurora v2)\n                         Edge proxy (Cloudflare) in front of regional ALB  ·  WAF-protected ingress  ·  Centralised secrets + per-task IAM (least-privilege)\n                         Observability via CloudWatch Logs+Alarms+SNS  ·  GitOps CI/CD (GitHub Actions → ECR → ECS rolling deploy)",
      "lineHeight": 1.25,
      "baseline": 10,
      "angle": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1452128622,
      "version": 1,
      "versionNonce": 1588675649,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778171824109,
      "link": null,
      "locked": false
    }
