    {
      "id": "notes_lbl",
      "type": "text",
      "x": 80,
      "y": 1352,
      "width": 400,
      "height": 22,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "text": "Notes & Classification",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notes & Classification",
      "lineHeight": 1.25,
      "baseline": 16,
      "angle": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1326270331,
      "version": 1,
