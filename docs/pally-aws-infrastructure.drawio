          <mxGeometry x="2580" y="160" width="0" height="0" as="geometry"/>
        </mxCell>

        <mxCell id="legend2" value="Notes&#10;&#10;• Frontend (virfriendo.win) is on Cloudflare Pages — never hits AWS.&#10;• Only api.virfriendo.win goes through Cloudflare proxy → WAF → ALB → ECS.&#10;• Aurora endpoint sits inside VPC private subnets (only reachable from ECS).&#10;• S3 bucket has Public Access Block — clients access via 7-day presigned URLs.&#10;• Secrets Manager &#39;virfriendo/prod/database&#39; holds DB URL + ALL API keys (Anthropic, Groq, OpenAI, Gemini, Deepgram, Replicate, Tavily, Google OAuth, JWT secret).&#10;• ECR lifecycle keeps only the 2 most-recent active revisions (current: 10, 11).&#10;• 5 services in the application code live in the SAME container image — currently the whole monolith image (virfriendo-api:latest) runs as 1 ECS service, scaled by ECS Auto Scaling (1–3 tasks)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#a38812;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="430" width="500" height="240" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
