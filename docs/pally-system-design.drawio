        <!-- ========== MICROSERVICES TIER ========== -->
        <mxCell id="ms_box" value="3. MICROSERVICES TIER &#8212; Docker network &#39;virfriendo&#39; (service discovery via Docker DNS / container names)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="1200" height="540" as="geometry"/>
        </mxCell>

        <!-- API GATEWAY / BFF -->
        <mxCell id="svc_api" value="api (BFF / Gateway)&#10;virfriendo_api  &#8226;  :8000&#10;&#10;services.core.main:app&#10;&#10;• Auth / JWT / OAuth&#10;• REST routers (chat, diary,&#10;  game, agents, caro,&#10;  external_game, turn_game)&#10;• WebSocket /chat/ws&#10;• Orchestrates downstream&#10;  services (httpx async)&#10;&#10;Pattern: API Gateway + BFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="140" width="240" height="280" as="geometry"/>
        </mxCell>

        <!-- AGENT SERVICE -->
        <mxCell id="svc_agent" value="agent service&#10;virfriendo_agent  &#8226;  :8010&#10;&#10;services.agent_api.main:app&#10;&#10;Endpoints:&#10;• GET /health&#10;• POST /run  (LangGraph)&#10;&#10;Pipeline (StateGraph):&#10;classifier → emotion →&#10;route_intent → {chit_chat,&#10;guardrail, entertainment_expert,&#10;comfort, advice, crisis} → END&#10;&#10;Memory extract + persona buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="140" width="240" height="280" as="geometry"/>
        </mxCell>

        <!-- MEDIA SERVICE -->
        <mxCell id="svc_media" value="media service&#10;virfriendo_media  &#8226;  :8020&#10;&#10;services.media_api.main:app&#10;&#10;Endpoints:&#10;• GET /health&#10;• POST /chat/transcribe&#10;• POST /chat/analyze-media&#10;• POST /chat/imagine&#10;&#10;Calls:&#10;• Deepgram / Groq Whisper&#10;• Gemini 1.5 Pro / GPT-4o&#10;• Replicate FLUX&#10;• knowledge service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="140" width="240" height="280" as="geometry"/>
