        <mxCell id="redis" value="Redis 7&#10;virfriendo_redis  &#8226;  :6379&#10;&#10;Session cache&#10;Personality buffer&#10;Rate-limit counters&#10;Pub/Sub" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
