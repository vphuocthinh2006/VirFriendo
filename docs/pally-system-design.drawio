        <!-- ========== INFRA / DEVOPS ========== -->
        <mxCell id="infra_box" value="6. INFRASTRUCTURE / DEVOPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
