        <mxCell id="pg" value="PostgreSQL 16&#10;virfriendo_db  &#8226;  :5432&#10;&#10;Users • Conversations&#10;Messages • Diary&#10;UserMemory • Game state" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
