        <!-- ========== DATA TIER ========== -->
        <mxCell id="data_box" value="5. DATA / STATEFUL TIER  (polyglot persistence &#8212; each store is its own container, not a microservice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="660" width="1200" height="200" as="geometry"/>
