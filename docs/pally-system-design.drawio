        </mxCell>
        <mxCell id="ecr" value="Amazon ECR&#10;Single Docker image,&#10;different CMD per service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ae4132;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="240" height="60" as="geometry"/>
        </mxCell>
