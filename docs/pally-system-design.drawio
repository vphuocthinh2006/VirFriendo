          <mxGeometry x="320" y="620" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="logs" value="CloudWatch Logs / Metrics&#10;Per-service log group + dashboards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ae4132;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="secrets" value="AWS Secrets Manager / .env&#10;API keys, DB creds, JWT secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ae4132;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="700" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="docker" value="docker-compose (local dev) — 8 containers:&#10;web • api • agent • media • retrieval • knowledge • postgres • redis • chroma" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ae4132;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="500" height="60" as="geometry"/>
        </mxCell>

        <!-- ========== CLASSIFICATION ========== -->
        <mxCell id="legend_box" value="System Design Classification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#a38812;fontStyle=1;fontSize=14;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="2320" height="380" as="geometry"/>
        </mxCell>

        <mxCell id="legend1" value="● MICROSERVICES ARCHITECTURE&#10;  5 services: api (BFF) • agent • media&#10;  • retrieval • knowledge.&#10;  Each is its OWN container, OWN port,&#10;  OWN uvicorn process.&#10;&#10;● API GATEWAY / BFF pattern&#10;  api service is the only public entry;&#10;  ALB routes ALL client traffic to it.&#10;  api fans out to internal services." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a38812;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="430" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="legend2" value="● Service-to-Service (synchronous HTTP)&#10;  httpx.AsyncClient + JSON.&#10;  Service discovery via Docker DNS:&#10;  AGENT_SERVICE_URL=http://agent:8010&#10;&#10;● Real-time streaming&#10;  WebSocket /chat/ws on api gateway,&#10;  token-stream protocol&#10;  (stream_start • token • stream_end).&#10;&#10;● Multi-modal AI&#10;  text + voice STT + vision + image gen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a38812;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="510" y="940" width="430" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="legend3" value="● Agentic AI System&#10;  agent service runs LangGraph StateGraph&#10;  (classifier → emotion → routed nodes).&#10;&#10;● RAG (Retrieval-Augmented Generation)&#10;  retrieval (Tavily) + knowledge (web/YT)&#10;  + ChromaDB vector store.&#10;&#10;● Polyglot Persistence&#10;  PostgreSQL + Redis + ChromaDB + S3,&#10;  each chosen for its data shape." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a38812;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="940" width="430" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="legend4" value="● Provider abstraction with fallback chain&#10;  Claude→Groq→OpenAI / Gemini→GPT-4o&#10;  / Deepgram→Whisper.&#10;&#10;● Resilience patterns&#10;  Per-service /health, depends_on conditions,&#10;  RETRIEVAL_PROXY_ENABLED toggle,&#10;  remote-or-local fallback in core.&#10;&#10;● Safety / Guardrail pattern&#10;  Crisis routing + out-of-domain guardrail&#10;  inside the agent graph." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a38812;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1410" y="940" width="430" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="legend5" value="● Cloud-native deployment&#10;  Docker • ECR • ECS Fargate&#10;  • ALB • CloudWatch • Secrets Mgr.&#10;&#10;● CI/CD (GitHub Actions)&#10;  lint → test → build → push → deploy&#10;  per-service task definitions.&#10;&#10;TÓM LẠI:&#10;Real-time Multi-modal Agentic AI Chat&#10;trên kiến trúc Microservices&#10;(API Gateway + RAG, polyglot persistence,&#10;cloud-native AWS)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#a38812;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1860" y="940" width="450" height="320" as="geometry"/>
        </mxCell>

        <!-- ========== EDGES ========== -->
        <mxCell id="e1" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="client_users" target="client_spa">
