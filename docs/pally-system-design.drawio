        <mxCell id="s3" value="S3 / Object storage&#10;Generated images, voice clips,&#10;user uploads (public CDN URLs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
