        <!-- RETRIEVAL SERVICE -->
        <mxCell id="svc_retrieval" value="retrieval service&#10;virfriendo_retrieval  &#8226;  :8031&#10;&#10;services.retrieval_api.main:app&#10;&#10;Endpoints:&#10;• GET /health&#10;• POST /tavily-search&#10;&#10;Tasks:&#10;• Tavily web search proxy&#10;• Wiki / community lookups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="440" width="240" height="180" as="geometry"/>
        </mxCell>

        <!-- Inter-service note -->
        <mxCell id="ms_note" value="Service-to-service communication&#10;&#10;• Synchronous HTTP/JSON&#10;  via httpx.AsyncClient&#10;• Service discovery: Docker DNS&#10;  (env: AGENT_SERVICE_URL=http://agent:8010 …)&#10;• Health-check at /health (per service)&#10;• Fallback pattern:&#10;  if SERVICE_URL set → remote call,&#10;  else → local in-process fallback&#10;• Timeouts: 25–120s; circuit-aware&#10;&#10;Each service shares the SAME image&#10;but runs a DIFFERENT uvicorn entrypoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#a38812;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1460" y="140" width="320" height="280" as="geometry"/>
        </mxCell>

