# ===== VirFriendo — Environment Variables Example =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---------- Postgres ----------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=virfriendo
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/virfriendo

# ---------- App core ----------
SECRET_KEY=generate_with_openssl_rand_hex_32
APP_ENV=development
DEBUG=false

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM providers (set at least one) ----------
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=AIza...

LLM_PROVIDER=claude   # claude | openai | groq | auto
LLM_MAX_TOKENS=1024
LLM_MAX_HISTORY=12

# ---------- Voice transcription ----------
DEEPGRAM_API_KEY=...

# ---------- Image generation ----------
REPLICATE_API_TOKEN=r8_...
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# ---------- Web search ----------
TAVILY_API_KEY=tvly-...
TAVILY_SEARCH_DEPTH=basic
ENABLE_WEB_SEARCH=true

# ---------- Redis & ChromaDB ----------
REDIS_URL=redis://localhost:6379/0
CHROMA_SERVER_URL=http://localhost:8003
AGENT_SERVICE_URL=http://localhost:8010
MEDIA_SERVICE_URL=http://localhost:8020
RETRIEVAL_SERVICE_URL=http://localhost:8031
KNOWLEDGE_SERVICE_URL=http://localhost:8041

# ---------- Optional: S3 (user uploads + /imagine outputs) ----------
# Leave S3_MEDIA_BUCKET empty to skip S3. Use IAM role on ECS or set keys locally.
# S3_MEDIA_BUCKET=your-bucket-name
# S3_MEDIA_PREFIX=virfriendo
# S3_GET_PRESIGNED_SECONDS=604800
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------- Optional local ML (NLP multitask BERT + ViT gallery) ----------
# Requires: pip install -r requirements-ml.txt (also baked into Dockerfile builder stage)
# ENABLE_NLP_METADATA=false
# NLP_MODEL_PATH=./path/to/intent_emotion_model.pth
# NLP_LABEL_PATH=./path/to/id_to_label.txt
# NLP_BERT_NAME=bert-base-uncased
# ENABLE_LLM_DOUBLE_CHECK=false
# DOUBLE_CHECK_MODEL=llama-3.1-8b-instant
# ML_DEVICE=cpu
#
# ENABLE_VIT_GALLERY=false
# VIT_MODEL_PATH=./path/to/best_vit_model.pth
# VIT_TIMM_MODEL=vit_base_patch16_224
# VIT_NUM_CLASSES=45
# GALLERY_EMBEDDINGS_NPY_PATH=./path/to/gallery_embeddings.npy
# GALLERY_CLASS_NAMES_PKL_PATH=./path/to/class_names.pkl
# GALLERY_VECTOR_BACKEND=numpy
# CHROMA_GALLERY_COLLECTION=character_gallery_vit
# --- Ingest exemplar vectors once: ---
# python scripts/ingest_gallery_chroma.py --embeddings ... --class-names ...
