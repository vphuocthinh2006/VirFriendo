# ===== VirFriendo — Environment Variables Example =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---------- Postgres ----------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=virfriendo
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/virfriendo

# ---------- App core ----------
SECRET_KEY=generate_with_openssl_rand_hex_32
APP_ENV=development
DEBUG=false

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM providers (set at least one) ----------
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=AIza...

LLM_PROVIDER=claude   # claude | openai | groq | auto
LLM_MAX_TOKENS=1024
LLM_MAX_HISTORY=12

# ---------- Voice transcription ----------
DEEPGRAM_API_KEY=...

# ---------- Image generation ----------
REPLICATE_API_TOKEN=r8_...
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# ---------- Web search ----------
TAVILY_API_KEY=tvly-...
TAVILY_SEARCH_DEPTH=basic
ENABLE_WEB_SEARCH=true

# ---------- Redis & ChromaDB ----------
REDIS_URL=redis://localhost:6379/0
CHROMA_SERVER_URL=http://localhost:8003
AGENT_SERVICE_URL=http://localhost:8010
MEDIA_SERVICE_URL=http://localhost:8020
RETRIEVAL_SERVICE_URL=http://localhost:8031
KNOWLEDGE_SERVICE_URL=http://localhost:8041

# ---------- Optional: S3 (user uploads + /imagine outputs) ----------
# Leave S3_MEDIA_BUCKET empty to skip S3. Use IAM role on ECS or set keys locally.
# S3_MEDIA_BUCKET=your-bucket-name
# S3_MEDIA_PREFIX=virfriendo
# S3_GET_PRESIGNED_SECONDS=604800
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
