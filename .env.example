# ===== VirFriendo — Environment Variables Example =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---------- Postgres ----------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=virfriendo
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/virfriendo

# ---------- App core ----------
SECRET_KEY=generate_with_openssl_rand_hex_32
APP_ENV=development
DEBUG=false

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM providers (set at least one) ----------
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=AIza...

LLM_PROVIDER=claude   # claude | openai | groq | auto
LLM_MAX_TOKENS=1024
LLM_MAX_HISTORY=12

# ---------- Voice transcription ----------
DEEPGRAM_API_KEY=...

# ---------- Image generation ----------
REPLICATE_API_TOKEN=r8_...
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# ---------- Web search ----------
TAVILY_API_KEY=tvly-...
TAVILY_SEARCH_DEPTH=basic
ENABLE_WEB_SEARCH=true

# ---------- Redis & ChromaDB ----------
REDIS_URL=redis://localhost:6379/0
CHROMA_SERVER_URL=http://localhost:8003
